<?xml version="1.0" encoding="UTF-8"?>
<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2">
    <file original="" product-name="NEOSidekick.Revisions" source-language="en" target-language="de" datatype="plaintext">
        <body>
            <trans-unit id="header.label">
                <source>Label</source>
                <target>Bezeichnung</target>
            </trans-unit>
            <trans-unit id="header.actions">
                <source>Actions</source>
                <target>Aktionen</target>
            </trans-unit>
            <trans-unit id="header.identifier">
                <source>Identifier</source>
                <target>Kennung</target>
            </trans-unit>
            <trans-unit id="header.creator">
                <source>Creator</source>
                <target>Erstellt von</target>
            </trans-unit>
            <trans-unit id="header.revision">
                <source>Revision</source>
                <target>Revision</target>
            </trans-unit>
            <trans-unit id="header.moved">
                <source>Moved</source>
                <target>Verschoben</target>
            </trans-unit>

            <trans-unit id="list.noRevisionsFound">
                <source>No revisions found</source>
                <target>Keine Revisionen gefunden</target>
            </trans-unit>

            <trans-unit id="revision.label">
                <source>By {creator}</source>
                <target>Von {creator}</target>
            </trans-unit>
            <trans-unit id="revision.isMoved">
                <source>Document was moved</source>
                <target>Dokument wurde verschoben</target>
            </trans-unit>
            <trans-unit id="tooltip.revisionLabel">
                <source>Created on {revisionDate} by {creator}</source>
                <target>Erstellt am {revisionDate} von {creator}</target>
            </trans-unit>

            <trans-unit id="action.close">
                <source>Close</source>
                <target>Schließen</target>
            </trans-unit>
            <trans-unit id="action.apply">
                <source>Apply</source>
                <target>Anwenden</target>
            </trans-unit>
            <trans-unit id="action.apply.newRevisionLabel">
                <source>Applied revision {revision}</source>
                <target>Angewandte Revision {revision}</target>
            </trans-unit>
            <trans-unit id="action.apply.disabled.title">
                <source>This revision cannot be applied</source>
                <target>Diese Änderung kann nicht angewendet werden</target>
            </trans-unit>

            <trans-unit id="action.apply.title">
                <source>Apply revision {revisionDate} by {creator}</source>
                <target>Revision {revisionDate} von {creator} anwenden</target>
            </trans-unit>
            <trans-unit id="action.edit.title">
                <source>Edit revision {revisionDate} by {creator}</source>
                <target>Revision {revisionDate} von {creator} bearbeiten</target>
            </trans-unit>
            <trans-unit id="action.delete.title">
                <source>Delete revision {revisionDate} by {creator}</source>
                <target>Revision {revisionDate} von {creator} löschen</target>
            </trans-unit>

            <trans-unit id="success.revisionApplied">
                <source>Revision applied</source>
                <target>Revision angewandt</target>
            </trans-unit>
            <trans-unit id="success.revisionApplied.message">
                <source>Revision "{label}" by "{creator}" applied.</source>
                <target>Revision "{label}" von "{creator}" angewendet.</target>
            </trans-unit>
            <trans-unit id="success.revisionDeleted">
                <source>Revision deleted</source>
                <target>Revision gelöscht</target>
            </trans-unit>
            <trans-unit id="success.revisionDeleted.message">
                <source>Revision "{label}" by "{creator} deleted.</source>
                <target>Revision "{label}" von "{creator} gelöscht.</target>
            </trans-unit>
            <trans-unit id="success.revisionUpdated">
                <source>Revision updated</source>
                <target>Revision aktualisiert</target>
            </trans-unit>
            <trans-unit id="success.revisionUpdated.message">
                <source>Revision {label} by "{creator}" updated.</source>
                <target>Revision {label} von "{creator}" aktualisiert.</target>
            </trans-unit>

            <trans-unit id="error.failedFetchingRevisions">
                <source>An error occurred while fetching revisions.</source>
                <target>Beim Abrufen von Revisionen ist ein Fehler aufgetreten.</target>
            </trans-unit>
            <trans-unit id="error.failedApplyingRevision">
                <source>An error occurred while applying revision.</source>
                <target>Bei der Anwendung der Revision ist ein Fehler aufgetreten.</target>
            </trans-unit>
            <trans-unit id="error.failedUpdatingRevision">
                <source>An error occurred while updating revision.</source>
                <target>Beim Aktualisieren der Revision ist ein Fehler aufgetreten.</target>
            </trans-unit>
            <trans-unit id="error.failedDeletingRevision">
                <source>An error occurred while deleting a revision.</source>
                <target>Beim Löschen einer Revision ist ein Fehler aufgetreten.</target>
            </trans-unit>
            <trans-unit id="error.revisionNotFound">
                <source>Revision not found</source>
                <target>Revision nicht gefunden</target>
            </trans-unit>
            <trans-unit id="error.nodeNotFound">
                <source>Page not found</source>
                <target>Seite nicht gefunden</target>
            </trans-unit>
            <trans-unit id="error.revisionNotApplied">
                <source>Failed to apply revision</source>
                <target>Revision konnte nicht angewandt werden</target>
            </trans-unit>
            <trans-unit id="error.revisionNotApplicable">
                <source>Revision cannot be applied</source>
                <target>Revision kann nicht angewandt werden</target>
            </trans-unit>
            <trans-unit id="error.revisionApplyDenied">
                <source>Not allowed to apply the revision</source>
                <target>Keine Berechtigung, diese Revision anzuwenden</target>
            </trans-unit>

            <trans-unit id="resolution.title">
                <source>Decide how to apply the revision</source>
                <target>Entscheiden, wie die Revision angewandt wird</target>
            </trans-unit>
            <trans-unit id="resolution.description">
                <source>Some content changed since the revision in a way that needs a decision.</source>
                <target>Einige Inhalte haben sich seit der Revision so verändert, dass eine Entscheidung nötig ist.</target>
            </trans-unit>
            <trans-unit id="resolution.errors">
                <source>The revision cannot be applied like this:</source>
                <target>So kann die Revision nicht angewandt werden:</target>
            </trans-unit>
            <trans-unit id="resolution.apply">
                <source>Apply revision</source>
                <target>Revision anwenden</target>
            </trans-unit>
            <trans-unit id="resolution.cancel">
                <source>Cancel</source>
                <target>Abbrechen</target>
            </trans-unit>
            <trans-unit id="resolution.problem.nodeTypeMissing">
                <source>The node type "{nodeType}" no longer exists.</source>
                <target>Den Inhaltstyp "{nodeType}" gibt es nicht mehr.</target>
            </trans-unit>
            <trans-unit id="resolution.problem.nodeTypeNotAllowed">
                <source>The node type "{nodeType}" is no longer allowed here.</source>
                <target>Der Inhaltstyp "{nodeType}" ist hier nicht mehr erlaubt.</target>
            </trans-unit>
            <trans-unit id="resolution.problem.parentMissing">
                <source>The place of this content in the revision no longer exists.</source>
                <target>Die Stelle dieses Inhalts in der Revision gibt es nicht mehr.</target>
            </trans-unit>
            <trans-unit id="resolution.problem.movedAway">
                <source>Moved to the page "{document}" since the revision.</source>
                <target>Seit der Revision auf die Seite "{document}" verschoben.</target>
            </trans-unit>
            <trans-unit id="resolution.problem.movedAway.unknown">
                <source>Moved to an unknown place since the revision.</source>
                <target>Seit der Revision an einen unbekannten Ort verschoben.</target>
            </trans-unit>
            <trans-unit id="resolution.problem.movedHere">
                <source>Moved to this page since the revision.</source>
                <target>Seit der Revision auf diese Seite verschoben.</target>
            </trans-unit>
            <trans-unit id="resolution.choice.skip">
                <source>Skip</source>
                <target>Überspringen</target>
            </trans-unit>
            <trans-unit id="resolution.choice.leaveThere">
                <source>Leave there</source>
                <target>Dort lassen</target>
            </trans-unit>
            <trans-unit id="resolution.choice.keep">
                <source>Keep</source>
                <target>Behalten</target>
            </trans-unit>
            <trans-unit id="resolution.choice.moveBack">
                <source>Move back</source>
                <target>Zurückverschieben</target>
            </trans-unit>
            <trans-unit id="resolution.choice.remove">
                <source>Remove</source>
                <target>Entfernen</target>
            </trans-unit>

            <trans-unit id="confirm.applyRevision">
                <source>Do you want to apply revision {revisionDate} by {creator}?</source>
                <target>Möchten Sie Revision {revisionDate} von {creator} anwenden?</target>
            </trans-unit>

            <trans-unit id="diff.header">
                <source>Version "{version}" (created on {date}) contains the following changes:</source>
                <target>Version "{version}" (erstellt am {date}) enthält die folgenden Änderungen:</target>
            </trans-unit>
            <trans-unit id="diff.propertyLabel">
                <source>Modification of the "{propertyLabel}" property</source>
                <target>Änderung der Eigenschaft "{propertyLabel}"</target>
            </trans-unit>
            <trans-unit id="diff.removeNode">
                <source>Remove</source>
                <target>Entferne</target>
            </trans-unit>
            <trans-unit id="diff.addNode">
                <source>Add</source>
                <target>Füge hinzu</target>
            </trans-unit>
            <trans-unit id="diff.changeNode">
                <source>Update</source>
                <target>Aktualisiere</target>
            </trans-unit>
            <trans-unit id="diff.old">
                <source>Old</source>
                <target>Alt</target>
            </trans-unit>
            <trans-unit id="diff.new">
                <source>New</source>
                <target>Neu</target>
            </trans-unit>
            <trans-unit id="diff.empty">
                <source>No changes have been found</source>
                <target>Es wurden keine Änderungen festgestellt</target>
            </trans-unit>
            <trans-unit id="diff.moved">
                <source>Note: the document was moved in this revision, but will not be moved back to its original location when applied.</source>
                <target>Hinweis: Das Dokument wurde in dieser Revision verschoben, wird aber bei der Anwendung nicht an seinen ursprünglichen Ort zurückgeschoben.</target>
            </trans-unit>
        </body>
    </file>
</xliff>
